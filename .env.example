# =============================================================
# Переменные стенда для автотестов Гидроуклона.
# В git попадает ТОЛЬКО этот шаблон с плейсхолдерами.
# Реальные значения подставляются из GitLab CI variables при запуске пайпа.
# Владелец имён переменных — репозиторий hydro-backend-tests.
# Состав дополняется по мере написания клиентов.
# =============================================================

# --- Общее ---
TEST_ENV=                      # имя стенда (например, stand-1)
LOG_LEVEL=INFO

# --- Сервисы (HTTP) ---
STAND_BASE_URL=                # базовый URL стенда, если сервисы за общим шлюзом
HYDRO_CALC_URL=                # hydro-calculation
HYDRO_HIST_URL=                # hydro-history-and-model
HMI_BACKEND_URL=               # hmi-backend
ALARM_SERVICE_URL=             # alarm-service

# --- WebSocket ---
WS_URL=                        # WebSocket hmi-backend

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --- Хранилища ---
POSTGRES_DSN=                  # PostgreSQL (информационная модель)
CLICKHOUSE_DSN=                # ClickHouse (исторические данные)

# --- HashiCorp Vault (если потребуется) ---
VAULT_ADDR=
VAULT_TOKEN=

# --- Внешние артефакты (крупные тестовые данные не в git) ---
TEST_DATA_BASE_DIR=            # путь/URL к каталогу крупных тестовых данных
